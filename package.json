{
  "name": "github-inspiration-feed",
  "description": "A mobile-first Chinese inspiration feed for turning GitHub repositories into focused product directions.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "refresh:repositories": "py -3.12 skills/github-inspiration-editor/scripts/refresh_repositories.py",
    "refresh:repositories:write": "py -3.12 skills/github-inspiration-editor/scripts/refresh_repositories.py --write",
    "refresh:research": "py -3.12 skills/github-inspiration-editor/scripts/refresh_research_sources.py",
    "refresh:research:write": "py -3.12 skills/github-inspiration-editor/scripts/refresh_research_sources.py --write",
    "refresh:cycle": "py -3.12 skills/github-inspiration-editor/scripts/run_refresh_cycle.py",
    "refresh:cycle:write": "py -3.12 skills/github-inspiration-editor/scripts/run_refresh_cycle.py --write",
    "refresh:cycle:resume": "py -3.12 skills/github-inspiration-editor/scripts/run_refresh_cycle.py --resume",
    "discover:repositories": "py -3.12 skills/github-inspiration-editor/scripts/discover_repositories.py",
    "discover:repositories:write": "py -3.12 skills/github-inspiration-editor/scripts/discover_repositories.py --write",
    "discover:drafts:write": "py -3.12 skills/github-inspiration-editor/scripts/generate_discovery_drafts.py --write",
    "discover:publish-batch": "py -3.12 skills/github-inspiration-editor/scripts/publish_discovery_batch.py",
    "versions:create": "py -3.12 skills/github-inspiration-editor/scripts/manage_versions.py create",
    "versions:list": "py -3.12 skills/github-inspiration-editor/scripts/manage_versions.py list",
    "versions:show": "py -3.12 skills/github-inspiration-editor/scripts/manage_versions.py show",
    "versions:diff": "py -3.12 skills/github-inspiration-editor/scripts/manage_versions.py diff",
    "versions:restore": "py -3.12 skills/github-inspiration-editor/scripts/manage_versions.py restore",
    "export:published-baselines": "py -3.12 skills/github-inspiration-editor/scripts/export_published_baselines.py",
    "publication:prepare": "py -3.12 skills/github-inspiration-editor/scripts/manage_publication.py prepare",
    "publication:approve": "py -3.12 skills/github-inspiration-editor/scripts/manage_publication.py approve",
    "publication:publish": "py -3.12 skills/github-inspiration-editor/scripts/manage_publication.py publish",
    "publication:recover": "py -3.12 skills/github-inspiration-editor/scripts/manage_publication.py recover",
    "test:identity-renderer": "node scripts/test-project-identity.mjs",
    "test:refresh-cycle": "python skills/github-inspiration-editor/scripts/test_refresh_cycle.py",
    "test:version-manager": "python skills/github-inspiration-editor/scripts/test_version_manager.py",
    "test:research-refresh": "python skills/github-inspiration-editor/scripts/test_research_refresh.py",
    "test:repository-refresh": "python skills/github-inspiration-editor/scripts/test_refresh_repositories.py",
    "test:visual-identity": "python skills/github-inspiration-editor/scripts/test_visual_identity.py",
    "test:publication-workflow": "python skills/github-inspiration-editor/scripts/test_publication_workflow.py",
    "test:repository-discovery": "python skills/github-inspiration-editor/scripts/test_repository_discovery.py",
    "test:discovery-drafts": "python skills/github-inspiration-editor/scripts/test_discovery_drafts.py",
    "test:discovery-batch-publication": "python skills/github-inspiration-editor/scripts/test_discovery_batch_publication.py",
    "test:discovery-workflows": "python skills/github-inspiration-editor/scripts/test_discovery_workflows.py",
    "validate:research": "python skills/github-inspiration-editor/scripts/validate_research.py",
    "validate:research-review": "python skills/github-inspiration-editor/scripts/validate_research_review.py",
    "validate:project": "python skills/github-inspiration-editor/scripts/validate_project.py",
    "validate:quality-review": "python skills/github-inspiration-editor/scripts/validate_quality_review.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@rolldown/binding-win32-x64-msvc": "^1.2.5",
    "@terry/selector-dev": "file:../plugins/selector-dev",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "typescript-eslint": "latest"
  }
}
